# Ornek Ar-Ge ayarlari; gercek model limitleri veya kurum bilgileri degildir.
# .env olarak kopyalayin. SESSION_SIGNING_KEY icin yerelde guclu rastgele deger uretin.
# Bos opsiyonel path alanlari None olarak yorumlanmali; browser path bosken override etme.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=Europe/Istanbul
APP_BASE_URL=http://127.0.0.1:8000
# AUTH_MODE: dev (yalniz yerel gelistirme) | unconfigured | local_admin (gecici tek admin; kurumsal SSO degildir).
AUTH_MODE=dev
DEV_AUTH_ENABLED=true
SESSION_SIGNING_KEY=
# Yalniz AUTH_MODE=local_admin: varsayilan hesap yoktur. Hash: agentask --hash-admin-password
# DEV_AUTH_ENABLED=false olmali. HTTPS veya loopback disi adreste ADMIN_COOKIE_SECURE=true.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300
ADMIN_COOKIE_SECURE=false
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=agentask_arge
MONGO_TLS_CA_FILE=
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# Yayimlanmis katalog deposu: mongo | disabled (disabled iken onay/yayin 503 doner; taslak ve deneme calisir).
CATALOG_BACKEND=mongo
# Yayin pointer'inin bagli oldugu ortam adi (application_id + environment tekil).
CATALOG_ENVIRONMENT=arge
# Asistan ve tasarimcinin calistigi hedef uygulama kimligi (yerel deney uygulamasi: lab).
CATALOG_APPLICATION_ID=lab
DRAFT_BACKEND=local_file
DRAFT_DIRECTORY=./var/drafts
ARTIFACT_DIRECTORY=./var/artifacts
# Dosya/kanit basina ust sinir (bayt). Ekran goruntusu yalniz maskelemesi dogrulanmissa kaydedilir.
ARTIFACT_MAX_BYTES=10485760
# Dosya/kanit nesne deposu: local (ARTIFACT_DIRECTORY) | s3 (kurum ici S3 uyumlu; ADR 0018).
ARTIFACT_BACKEND=local
# Dosya metadatasi: local (ARTIFACT_DIRECTORY/index) | mongo (MONGO_URI/MONGO_DATABASE; CATALOG_BACKEND=mongo gerekir).
ARTIFACT_INDEX_BACKEND=local
# Yalniz ARTIFACT_BACKEND=s3 icin. Uc nokta https olmali (yalniz loopback test deposu http); adreste kimlik olmaz.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
# Kova icindeki onek (bos veya "ad/" bicimi).
S3_PREFIX=
# Gercek degerler yalniz guvenli .env/Secret ile verilir; bu dosyaya yazilmaz.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Kurum CA dosyasi (istege bagli). TLS dogrulamasi kapatilamaz.
S3_CA_BUNDLE=
# path (https://uc-nokta/kova/anahtar) | virtual (https://kova.uc-nokta/anahtar)
S3_ADDRESSING_STYLE=path
S3_TIMEOUT_MS=10000
RUNNER_MODE=local
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=false
BROWSER_EXECUTABLE_PATH=
PLAYWRIGHT_BROWSERS_PATH=
BROWSER_LAUNCH_TIMEOUT_MS=30000
# Ayni anda acik browser oturumu (context) siniri; kullanici basina sinir toplami asamaz.
BROWSER_MAX_SESSIONS=4
BROWSER_MAX_SESSIONS_PER_USER=1
# Katalog Tasarimcisi 'yeni oturum testi' icin kullanicinin acabilecegi gecici dogrulama oturumu sayisi.
# Etkilesimli oturum sinirina sayilmaz; toplam BROWSER_MAX_SESSIONS icindedir; is bitince (hata dahil) kapanir.
BROWSER_MAX_VERIFICATION_SESSIONS_PER_USER=1
# Bu sure boyunca kullanilmayan (islemde olmayan) oturum kapatilir.
BROWSER_SESSION_IDLE_SECONDS=900
# Yeni oturum testinde hedef uygulamaya elle giris icin bekleme ust siniri.
FRESH_TEST_LOGIN_TIMEOUT_SECONDS=600
TARGET_ALLOWED_ORIGINS=["http://127.0.0.1:8100","http://127.0.0.1:8101"]
TARGET_BASE_URL=http://127.0.0.1:8100
# Kullaniciya gosterilen otomasyon uygulamalari (JSON liste). Her kayit: id (sabit, benzersiz; katalogdaki
# application_id ile ayni anlam), name (gosterilen ad), base_url (baslangic adresi; origin'i TARGET_ALLOWED_ORIGINS
# icinde olmali). Bos liste [] gecerlidir; varsayilan/uretim adresi eklenmez. Listede bulunmak yetki vermez.
# Liste bos degilse CATALOG_APPLICATION_ID bu id'lerden biri olmali. Etkin ornek tek uygulamali yerel lab'dir.
# Tirnak notu: .env dosyasinda '...' tirnaklari okunurken kaldirilir; ayni degeri dogrudan ortam degiskeni
# olarak verirken tirnak eklemeyin (ortam degiskeninde tirnak degerin parcasi sayilir ve JSON gecersiz olur).
AUTOMATION_APPLICATIONS_JSON=[{"id":"lab","name":"Yerel deney uygulaması","base_url":"http://127.0.0.1:8100/"}]
# Alternatif: iki uygulamali yerel ornek (ikinci origin de TARGET_ALLOWED_ORIGINS icinde):
# AUTOMATION_APPLICATIONS_JSON=[{"id":"lab","name":"Yerel deney uygulaması","base_url":"http://127.0.0.1:8100/"},{"id":"lab_ikinci","name":"Yerel deney uygulaması (ikinci origin)","base_url":"http://127.0.0.1:8101/"}]
# Yerel deney uygulamasi (gercek Pega degildir). Yalnizca loopback http; production'da bos birakilmali.
# Ikinci origin cross-origin frame senaryosu icindir. Ikisi birlikte verilir.
LAB_PRIMARY_ORIGIN=http://127.0.0.1:8100
LAB_SECONDARY_ORIGIN=http://127.0.0.1:8101
ACTION_TIMEOUT_MS=10000
NAVIGATION_TIMEOUT_MS=15000
READINESS_TIMEOUT_MS=15000
# Secim alani: secimden sonra ekranin duruldugunu gormek icin DOM sessizlik suresi ve gec yuklenen secenekleri
# bekleme ust siniri (istege bagli; verilmezse bu varsayilanlar kullanilir).
CHOICE_SETTLE_MS=300
CHOICE_OPTIONS_WAIT_MS=5000
FRAME_SCAN_TIMEOUT_MS=5000
FRAME_SCAN_MAX_DEPTH=20
# Frame basina en fazla incelenecek kontrol sayisi; asilirsa frame 'partial' raporlanir.
FRAME_SCAN_MAX_ELEMENTS=3000
FRAME_SCAN_CONCURRENCY=4
# Tek gozlemin (tum frame'ler) toplam suresi ve incelenecek en fazla frame sayisi.
OBSERVE_TIMEOUT_MS=20000
OBSERVE_MAX_FRAMES=50
# Manuel secim sonucunu beklerken bir istegin en fazla bekleyecegi sure.
PICKER_WAIT_MAX_MS=25000
# Run checkpoint dosyalari (yerel Ar-Ge adapteri). Yeniden baslatmada okunur.
RUN_DIRECTORY=./var/runs
# Onayli aksiyon seti: none | lab (lab yalniz yerel deney uygulamasi icindir; production'da reddedilir) |
# file (kurumun onayladigi tipli JSON; APPROVED_ACTIONS_FILE ile).
APPROVED_ACTION_SET=lab
APPROVED_ACTIONS_FILE=
# Gonderim sonrasi sonuc kanitini bekleme ve belirsiz sonucu uzlastirma okumasi sureleri.
OUTCOME_TIMEOUT_MS=8000
RECONCILE_TIMEOUT_MS=8000
# Kaydirmali tabloda ilerleme olmadan art arda deneme siniri.
TABLE_NO_PROGRESS_LIMIT=3
# Birlestirme fazi (if / call_operation / sinirli for_each). Varsayilan kapali; statik dogrulamali.
COMPOSITION_ENABLED=false
COMPOSITION_MAX_DEPTH=3
COMPOSITION_MAX_ITEMS=20
RUN_MAX_STEPS=100
RUN_MAX_DURATION_SECONDS=300
TABLE_MAX_PAGES=20
TABLE_MAX_ROWS=1000
RECOVERY_MAX_ATTEMPTS=2
SESSION_LEASE_SECONDS=60
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_AUTH_MODE=none
LLM_API_KEY=
LLM_USERNAME=
LLM_PASSWORD=
LLM_TLS_VERIFY=true
LLM_CA_BUNDLE=
LLM_TIMEOUT_SECONDS=45
LLM_CONTEXT_TOKENS=8192
LLM_MAX_INPUT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=2048
LLM_CONTEXT_RESERVE_TOKENS=2048
LLM_MAX_CALLS_PER_RUN=3
# Loglar yalniz konsola (stdout) yazilir; uygulama log dosyasi tutmaz. LOG_FORMAT=json onerilir (text: ayni alanlar, tek satir).
# INFO: kullanici olaylari ve hatalar. DEBUG: basarili okuma istekleri de yazilir. Alan degerleri hicbir seviyede yazilmaz.
LOG_LEVEL=INFO
LOG_FORMAT=json
EVIDENCE_RETENTION_DAYS=7
EVIDENCE_SCREENSHOTS_ENABLED=false
# --- Yerel MongoDB otomatik baslatma (yalniz APP_ENV=development) ---
# false: uygulama yalniz MONGO_URI'ye baglanir; Docker/Compose hic cagrilmaz.
# true: gelistirme baslaticisi (python -m tools.local_mongo dev) yerel Compose servisini hazir eder.
LOCAL_MONGO_AUTOSTART=false
# Gercek ortam ornegi (LOCAL_MONGO_AUTOSTART=false ile mevcut MongoDB'ye baglanma):
# MONGO_URI=<gerçeks ortam bağlantısı>
# MONGO_DATABASE=<katalog veritabanı>
# Gercek ortam uygulama listesi ornegi (temsili adresler). Kullanmak icin bu origin'ler TARGET_ALLOWED_ORIGINS'e
# eklenmeli ve CATALOG_APPLICATION_ID bu id'lerden biri olmali (mevcut yayinlar o kimlikle kayitlidir):
# AUTOMATION_APPLICATIONS_JSON='[{"id":"nar","name":"Nar","base_url":"https://nar.example.internal"},{"id":"opera","name":"Opera","base_url":"https://opera.example.internal"}]'
# Yerel arac ayarlari (yalniz tools/local_mongo okur; uygulama bu onekli anahtarlari yok sayar):
LOCAL_MONGO_IMAGE=mongo:8.0
LOCAL_MONGO_PROJECT=agentask-local
LOCAL_MONGO_VOLUME=agentask-local-mongo-data
LOCAL_MONGO_PORT=27017
LOCAL_MONGO_START_TIMEOUT_SECONDS=60
LOCAL_MONGO_BACKUP_DIR=./var/mongo-backups
# Bos birakilirsa yerel servis kimlik dogrulamasiz (yalniz 127.0.0.1) calisir; doluysa MONGO_URI ayni kullaniciyi icermeli.
LOCAL_MONGO_ROOT_USERNAME=
LOCAL_MONGO_ROOT_PASSWORD=
